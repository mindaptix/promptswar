# Required
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/promptswar
AUTH_SECRET=replace-with-at-least-32-random-bytes
OPENAI_API_KEY=replace-with-server-side-key

# PostgreSQL transport: local deployments default to disable; remote hosts
# default to verify-full. Use require only when a provider cannot verify CA.
POSTGRES_SSL_MODE=disable
# POSTGRES_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Optional, bounded by the application even when misconfigured.
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_QUERY_TIMEOUT_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=10000
OPENAI_MODEL=gpt-4o-mini
